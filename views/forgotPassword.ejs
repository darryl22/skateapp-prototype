<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skatespot App</title>
    <link rel="stylesheet" href="/index.css">
</head>
<body>
    <%- include('templates/nav.ejs') %>
    <%- include('templates/alert.ejs') %>
    <%- include('templates/theme.ejs') %>
    <form action="" method="post" class="auth-div" id="forgotPasswordForm">
        <p style="text-align: center; font-size: 1.5em;">Forgot Password</p>
        <input type="text" class="auth-input" placeholder="email" name="email" id="email" required>
        <button class="auth-button">Confirm</button>
        <a href="/login" style="margin-top: 1em;" class="auth-link">login</a>
    </form>
    <form action="" method="post" class="auth-div hidden" id="resetPasswordForm">
        <p id="changeEmail" style="color: rgb(198, 198, 198); text-decoration: underline; text-underline-offset: 3px; cursor: pointer;">change email</p>
        <p id="tokenExpiryCounter">Token Expires in <span id="timerSpan"></span></p>
        <p id="resendTokenDiv">Token Expired</p>
        <button type="button" class="secondary-button" id="resendTokenButton">resend</button>

        <input type="text" class="auth-input" placeholder="token" name="token" id="token" required>
        <input type="password" class="auth-input" placeholder="newpassword" name="newpassword" id="newpassword" required>
        <input type="password" class="auth-input" placeholder="confirmnewpassword" name="confirmnewpassword" id="confirmnewpassword" required>
        <button class="auth-button">Confirm</button>
        <a href="/login" style="margin-top: 1em;" class="auth-link">login</a>
    </form>
    <div class="spinner-container" id="spinnerContainer">
        <img src="/logos/skateboardlight.png" alt="spinner" class="spinner">
    </div>
</body>
<script nonce="<%= cspNonce %>">
    let resetStep = "<%= resetStep %>"
    if(resetStep === "resetpassword") {
        document.getElementById("forgotPasswordForm").classList.add("hidden")
        document.getElementById("resetPasswordForm").classList.remove("hidden")
        let isExpired = '<%= expired %>'
        let tokenExpiryCounter = document.getElementById("tokenExpiryCounter")
        let resendTokenDiv = document.getElementById("resendTokenDiv")
        if (isExpired === "true") {
            tokenExpiryCounter.style.display = "none"
            resendTokenDiv.style.display = "flex"
        } else {
            tokenExpiryCounter.style.display = "block"
            resendTokenDiv.style.display = "none"
        }
    }
    let timerInterval = null
    function setTimer(duration, targetElement) {
        if (timerInterval !== null) {
            clearInterval(timerInterval)
        }
        let timerSpan = document.getElementById(targetElement)
        let temp = duration
        let initialMinute = parseInt((duration / 1000) / 60)
        let initialSeconds = parseInt((duration / 1000) - (initialMinute * 60))
        timerSpan.innerText = `${initialMinute}:${initialSeconds}`
        timerInterval = setInterval(() => {
            temp = (temp - 1000)
            let minute = parseInt((temp / 1000) / 60)
            let seconds = parseInt((temp / 1000) - (minute * 60))
            timerSpan.innerText = `${minute}:${seconds}`
        }, 1000);
        let timer = setTimeout(() => {
            clearInterval(timerInterval)
            // timerSpan.innerText = "done"
            tokenExpiryCounter.style.display = "none"
            resendTokenDiv.style.display = "flex"
        }, duration)
    }
    let duration = '<%= duration %>'
    setTimer(parseInt(duration), "timerSpan")

    document.getElementById("token").addEventListener("input", function() {
        this.value = this.value.toUpperCase()
    })
    document.getElementById("changeEmail").addEventListener("click", function() {
        document.getElementById("forgotPasswordForm").classList.remove("hidden")
        document.getElementById("resetPasswordForm").classList.add("hidden")
    })
    document.getElementById("forgotPasswordForm").addEventListener("submit", async function(e) {
        e.preventDefault()
        document.getElementById("spinnerContainer").style.display = "block"
        await fetch("/forgotPassword", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({
                email: document.getElementById("email").value,
                action: "sendemail"
            })
        })
        .then(async res => {
            document.getElementById("spinnerContainer").style.display = "none"
            if (!res.ok) {
                addNewAlert("ERROR", res.statusText)
                return
            }
            let resData = await res.json()
            if (resData.status === "SUCCESS") {
                this.classList.add("hidden")
                document.getElementById("resetPasswordForm").classList.remove("hidden")
                addNewAlert(resData.status, resData.message)
                setTimer(parseInt(resData.duration), "timerSpan")
            } else {
                addNewAlert(resData.status, resData.message)
            }
        })
        .catch(error => {
            document.getElementById("spinnerContainer").style.display = "none"
            addNewAlert("ERROR", "Error sending email")
        })
    })

    document.getElementById("resetPasswordForm").addEventListener("submit", async function(e) {
        e.preventDefault()
        await fetch("/forgotPassword", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({
                newpassword: document.getElementById("newpassword").value,
                confirmnewpassword: document.getElementById("confirmnewpassword").value,
                token: document.getElementById("token").value,
                action: "resetpassword"
            })
        })
        .then(async res => {
            let resData = await res.json()
            if (resData.status === "SUCCESS") {
                addNewAlert(resData.status, resData.message)
            } else {
                addNewAlert(resData.status, resData.message)
                if (resData.message === "Error getting email") {
                    document.getElementById("forgotPasswordForm").classList.remove("hidden")
                    document.getElementById("resetPasswordForm").classList.add("hidden")
                }
            }
        })
        .catch(error => {
            addNewAlert("ERROR", "An error occured with password reset.")
        })
    })

    document.getElementById("resendTokenButton").addEventListener("click", async function() {
        document.getElementById("spinnerContainer").style.display = "block"
        await fetch("/forgotPassword", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({
                action: 'resendToken',
            })
        })
        .then(async res => {
            document.getElementById("spinnerContainer").style.display = "none"
            let resData = await res.json()
            setTimer(parseInt(resData.duration), "timerSpan")
            tokenExpiryCounter.style.display = "block"
            resendTokenDiv.style.display = "none"
            addNewAlert("SUCCESS", "New token sent")
        })
        .catch(error => {
            document.getElementById("spinnerContainer").style.display = "none"
            addNewAlert("ERROR", "Error with token resend")
        })
    })
</script>
</html>