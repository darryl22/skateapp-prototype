<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skatespot App</title>
    <link rel="stylesheet" href="/index.css">
</head>
<body>
    <%- include('templates/nav.ejs') %>
    <%- include('templates/alert.ejs') %>
    <%- include('templates/theme.ejs') %>
    <form action="" method="post" class="auth-div" id="loginForm">
        <p style="text-align: center; font-size: 1.5em;">Login</p>
        <input type="text" class="auth-input" placeholder="email/username" name="username" id="username" required>
        <input type="password" class="auth-input" placeholder="password" name="password" id="password" required>
        <div style="margin-top: 1em;" class="checkbox-div">
            <input type="checkbox" name="rememberme" id="rememberme" class="checkbox">
            <label for="rememberme" style="margin: 0;">Remember me</label>
        </div>
        <button class="auth-button">Confirm</button>
        <a href="/forgotPassword" style="margin-top: 2em;" class="auth-link">forgot password</a>
        <!-- <p style="margin-top: 3em; margin-bottom: 0px;" id="forgotPassword">forgot password</p> -->
        <a href="/signup" style="margin-top: 1em;" class="auth-link">sign up</a>
    </form>
    <div class="spinner-container" id="spinnerContainer">
        <img src="/logos/skateboardlight.png" alt="spinner" class="spinner">
    </div>
</body>
<script nonce="<%= cspNonce %>">
    document.getElementById("loginForm").addEventListener("submit", async function(e) {
        e.preventDefault()
        document.getElementById("spinnerContainer").style.display = "block"
        await fetch("/login", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({
                username: document.getElementById("username").value,
                password: document.getElementById("password").value,
                rememberme: document.getElementById("rememberme").checked
            })
        })
        .then(async res => {
            document.getElementById("spinnerContainer").style.display = "none"
            if (!res.ok) {
                addNewAlert("ERROR", res.statusText)
                return
            }
            let resData = await res.json()
            if (resData.status === "SUCCESS") {
                addNewAlert(resData.status, resData.message)
                setTimeout(() => {
                    if (resData.action === "login") {
                        window.location.replace("/profile")
                    } else if (resData.action === "tfa") {
                        window.location.replace("/twoFactorAuth")
                    }
                }, 2000)
            } else {
                addNewAlert(resData.status, resData.message)
            }
        })
        .catch(error => {
            document.getElementById("spinnerContainer").style.display = "none"
            addNewAlert("ERROR", "Error with login")
        })
    })
</script>
</html>